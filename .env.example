# docker compose 설정 예시. `.env`로 복사해 값을 채우세요 — `.env`는 커밋되지 않습니다.
#
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (서버)

# DB 비밀번호. 영문·숫자만 쓰세요 — 특수문자는 DB 주소 안에서 깨질 수 있습니다.
DB_PASSWORD=

# 접속 주소.
#   로컬 확인  :80              → http://localhost
#   배포       dripdraw.store   → HTTPS 자동 발급 (도메인이 서버 IP를 가리키고 있어야 함)
SITE_ADDRESS=:80

# 호스트 포트. 로컬에서 80이 이미 쓰이고 있을 때만 바꾸세요. 배포에서는 80·443 그대로.
# HTTP_PORT=80
# HTTPS_PORT=443
