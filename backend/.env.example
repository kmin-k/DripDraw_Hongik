# 백엔드 설정 예시
#
# 기본값 그대로 돌아가므로 이 파일은 참고용입니다.
# 바꿀 것이 있을 때만 `.env`로 복사해 수정하세요 — `.env`는 커밋되지 않습니다.
#
#   cd backend
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS/Linux)

# DB 주소. 기본은 실행 위치(backend/) 기준 SQLite 파일입니다.
# 배포에서는 PostgreSQL 주소를 넣습니다: postgresql+psycopg://사용자:비밀번호@호스트:5432/DB이름
# 테이블은 서버가 켜질 때 마이그레이션으로 자동으로 맞춰집니다 (CONTRIBUTING.md "DB 구조 바꾸기").
DATABASE_URL=sqlite:///./dripdraw.db

# 서버가 켜질 때 DB를 최신 구조로 맞출지. 끌 일은 거의 없습니다.
AUTO_MIGRATE=true

# CORS 허용 origin. JSON 배열 형식으로 씁니다.
# 프론트를 다른 포트로 띄우거나 다른 기기에서 접속할 때 여기에 추가하세요.
CORS_ORIGINS=["http://localhost:5180"]
